{
  "manifest_version": 3,
  "name": "AirTab",
  "version": "1.0.0",
  "description": "Floating mini browser for instant in-page link previews, quick look-ups, and multi-tab browsing without leaving your tab.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "commands": {
    "open-airtab": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Open AirTab"
    }
  },
  "action": {
    "default_title": "AirTab"
  },
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "icons/*", "window.html", "window.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
